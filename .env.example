# OTOX Website SMTP Configuration
# ------------------------------------------------------------------
# Gmail / Google Workspace SMTP Setup:
# 1. Enable 2-Step Verification on your Google Account
# 2. Generate a 16-character App Password: https://myaccount.google.com/apppasswords
# 3. Paste the App Password as SMTP_PASS (never use your main Gmail password)
#
# In Vercel Dashboard -> Settings -> Environment Variables, add these same keys.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=kamalotox@gmail.com
SMTP_PASS=your_16_char_gmail_app_password

# Display name & sender email (Gmail requires MAIL_FROM_EMAIL to match SMTP_USER or a verified alias)
MAIL_FROM_NAME=OTOX Website Enquiries
MAIL_FROM_EMAIL=kamalotox@gmail.com

# Single destination email receiving all website form submissions
MAIL_TO=kamalotox@gmail.com
